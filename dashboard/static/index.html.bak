<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>CS2 LotL EDR — SOC Dashboard</title>
<link rel="stylesheet" href="/app.css">
</head>
<body>

<header class="topbar">
  <div class="brand">CS2 <span>LotL EDR</span></div>
  <div class="status-pills">
    <div class="pill" id="pill-system">
      <span class="dot"></span><span id="system-status">--</span>
    </div>
    <div class="pill" id="pill-ledger">
      <span class="dot"></span><span id="ledger-status">--</span>
    </div>
    <div class="pill">
      <span id="hostname">--</span>
    </div>
  </div>
</header>

<main class="layout">

  <section class="card metrics-row">
    <div class="metric">
      <div class="metric-value" id="m-compliance">--%</div>
      <div class="metric-label">CIS Compliance</div>
    </div>
    <div class="metric">
      <div class="metric-value" id="m-drift">--%</div>
      <div class="metric-label">Config Drift</div>
    </div>
    <div class="metric">
      <div class="metric-value" id="m-alerts">--</div>
      <div class="metric-label">Active Chains</div>
    </div>
    <div class="metric">
      <div class="metric-value" id="m-incidents">--</div>
      <div class="metric-label">Ledger Incidents</div>
    </div>
  </section>

  <section class="two-col">

    <div class="card">
      <div class="card-header">
        <h2>Attack Chains</h2>
        <span class="refresh-note">auto-refresh 5s</span>
      </div>
      <div id="chains-container" class="chains-container">
        <div class="empty-state">No active chains</div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h2>Configuration Drift</h2>
      </div>
      <div id="drift-container" class="drift-container">
        <div class="empty-state">No drift violations</div>
      </div>
    </div>

  </section>

  <section class="card">
    <div class="card-header">
      <h2>Attack Timeline</h2>
      <span class="refresh-note" id="timeline-count"></span>
    </div>
    <div class="table-wrap">
      <table class="timeline-table">
        <thead>
          <tr>
            <th>Time</th>
            <th>Source</th>
            <th>Event Type</th>
            <th>User</th>
            <th>Command</th>
            <th>Rules Matched</th>
            <th>Severity</th>
          </tr>
        </thead>
        <tbody id="timeline-body">
          <tr><td colspan="7" class="empty-state">No events yet</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <div class="card-header">
      <h2>GRC Evidence Ledger</h2>
      <button id="export-btn" class="btn-export">Export Report</button>
    </div>
    <div class="table-wrap">
      <table class="ledger-table">
        <thead>
          <tr>
            <th>Incident</th>
            <th>Timestamp</th>
            <th>User</th>
            <th>MITRE Tactics</th>
            <th>Risk Score</th>
            <th>Containment Actions</th>
            <th>Hash</th>
          </tr>
        </thead>
        <tbody id="ledger-body">
          <tr><td colspan="7" class="empty-state">No ledger entries</td></tr>
        </tbody>
      </table>
    </div>
  </section>

</main>

<script src="/app.js"></script>
</body>
</html>
