:root {
  --bg: #0b0f14;
  --panel: #121821;
  --panel-border: #1f2a37;
  --text: #d8e1ea;
  --text-dim: #7d8b9a;
  --accent: #3ba7ff;
  --green: #33d17a;
  --yellow: #e0a72e;
  --orange: #e0742e;
  --red: #e0453a;
  --critical: #ff3b5c;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  font-size: 14px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 24px;
  background: var(--panel);
  border-bottom: 1px solid var(--panel-border);
}

.brand {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.5px;
}
.brand span { color: var(--accent); font-weight: 400; }

.status-pills { display: flex; gap: 10px; align-items: center; }

.pill {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  background: #0e141b;
  border: 1px solid var(--panel-border);
  border-radius: 20px;
  font-size: 12px;
  color: var(--text-dim);
}
.pill .dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--text-dim);
  display: inline-block;
}
.pill.ok .dot { background: var(--green); }
.pill.warn .dot { background: var(--yellow); }
.pill.bad .dot { background: var(--critical); }

.layout {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 1400px;
  margin: 0 auto;
}

.card {
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: 10px;
  padding: 18px 20px;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}
.card-header h2 { font-size: 15px; font-weight: 600; }
.refresh-note { font-size: 11px; color: var(--text-dim); }

.metrics-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  padding: 20px;
}
.metric { text-align: center; }
.metric-value { font-size: 28px; font-weight: 700; color: var(--accent); }
.metric-label { font-size: 12px; color: var(--text-dim); margin-top: 4px; }

.two-col {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 20px;
}
@media (max-width: 900px) {
  .two-col { grid-template-columns: 1fr; }
}

.chains-container { display: flex; flex-direction: column; gap: 12px; max-height: 420px; overflow-y: auto; }

.chain-card {
  background: #0e141b;
  border: 1px solid var(--panel-border);
  border-left: 4px solid var(--text-dim);
  border-radius: 6px;
  padding: 12px 14px;
}
.chain-card.tier-monitor { border-left-color: var(--text-dim); }
.chain-card.tier-suspicious { border-left-color: var(--yellow); }
.chain-card.tier-high { border-left-color: var(--orange); }
.chain-card.tier-confirmed { border-left-color: var(--red); }
.chain-card.tier-critical { border-left-color: var(--critical); }

.chain-top { display: flex; justify-content: space-between; align-items: center; }
.chain-id { font-family: monospace; font-size: 12px; color: var(--text-dim); }
.chain-tier {
  font-size: 11px; font-weight: 700; text-transform: uppercase;
  padding: 2px 8px; border-radius: 10px;
}
.tier-monitor .chain-tier { background: #2a3441; color: var(--text-dim); }
.tier-suspicious .chain-tier { background: #4a3a12; color: var(--yellow); }
.tier-high .chain-tier { background: #4a2d12; color: var(--orange); }
.tier-confirmed .chain-tier, .tier-critical .chain-tier { background: #4a1414; color: var(--critical); }

.chain-meta {
  display: flex; gap: 16px; margin-top: 8px; font-size: 12px; color: var(--text-dim);
}
.chain-meta b { color: var(--text); }

.chain-bar-bg {
  margin-top: 8px; height: 6px; background: #1a222c; border-radius: 3px; overflow: hidden;
}
.chain-bar-fill { height: 100%; background: var(--accent); }
.tier-critical .chain-bar-fill, .tier-confirmed .chain-bar-fill { background: var(--critical); }
.tier-high .chain-bar-fill { background: var(--orange); }
.tier-suspicious .chain-bar-fill { background: var(--yellow); }

.contain-flag {
  margin-top: 8px; font-size: 11px; color: var(--critical); font-weight: 600;
}

.drift-container { display: flex; flex-direction: column; gap: 10px; max-height: 420px; overflow-y: auto; }
.drift-item {
  background: #0e141b; border: 1px solid var(--panel-border);
  border-left: 4px solid var(--yellow);
  border-radius: 6px; padding: 10px 12px; font-size: 12px;
}
.drift-item.critical { border-left-color: var(--critical); }
.drift-item.high { border-left-color: var(--orange); }
.drift-item .drift-entity { font-weight: 600; color: var(--text); }
.drift-item .drift-details { color: var(--text-dim); margin-top: 4px; }
.drift-item .drift-fix { color: var(--accent); margin-top: 4px; font-family: monospace; }

.table-wrap { overflow-x: auto; }

table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
thead th {
  text-align: left; color: var(--text-dim); font-weight: 600;
  padding: 8px 10px; border-bottom: 1px solid var(--panel-border);
  white-space: nowrap;
}
tbody td {
  padding: 8px 10px; border-bottom: 1px solid #1a222c;
  vertical-align: top;
}
tbody tr:hover { background: #0e141b; }

.sev-tag {
  font-size: 10px; font-weight: 700; text-transform: uppercase;
  padding: 2px 7px; border-radius: 8px;
}
.sev-normal { background: #1a222c; color: var(--text-dim); }
.sev-low { background: #1a2e22; color: var(--green); }
.sev-medium { background: #4a3a12; color: var(--yellow); }
.sev-high { background: #4a2d12; color: var(--orange); }
.sev-critical { background: #4a1414; color: var(--critical); }

.mono { font-family: monospace; font-size: 11.5px; }
.rule-chip {
  display: inline-block; background: #1a222c; color: var(--accent);
  font-family: monospace; font-size: 11px;
  padding: 1px 6px; border-radius: 4px; margin: 1px 2px 1px 0;
}

.hash-cell { font-family: monospace; font-size: 11px; color: var(--text-dim); }

.btn-export {
  background: var(--accent); color: #001522; border: none;
  padding: 7px 14px; border-radius: 6px; font-weight: 600;
  font-size: 12px; cursor: pointer;
}
.btn-export:hover { opacity: 0.85; }

.empty-state {
  color: var(--text-dim); text-align: center; padding: 30px 10px; font-size: 13px;
}
