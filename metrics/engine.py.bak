import os
import json
import time
from typing import Dict, Any, List, Optional
from lotl_edr.utils.logger import setup_logger

logger = setup_logger("metrics")

class MetricsEngine:
    def __init__(self, stats_path: str):
        self.stats_path = stats_path

        self.normalization_latencies: List[float] = []
        self.rule_latencies: List[float] = []
        self.correlation_latencies: List[float] = []
        self.risk_latencies: List[float] = []
        self.confidence_latencies: List[float] = []
        self.detections: List[Dict[str, float]] = []
        self.containments: List[Dict[str, float]] = []
        self.containment_outcomes: List[bool] = []
        self.alerts: List[str] = []
        self.drift_checks: List[Dict[str, Any]] = []

        os.makedirs(os.path.dirname(self.stats_path), exist_ok=True)
        self.load_stats()

    def load_stats(self) -> None:
        if not os.path.exists(self.stats_path):
            return

        try:
            with open(self.stats_path, "r", encoding="utf-8") as f:
                data = json.load(f)

            self.normalization_latencies = data.get("normalization_latencies", [])
            self.rule_latencies = data.get("rule_latencies", [])
            self.correlation_latencies = data.get("correlation_latencies", [])
            self.risk_latencies = data.get("risk_latencies", [])
            self.confidence_latencies = data.get("confidence_latencies", [])
            self.detections = data.get("detections", [])
            self.containments = data.get("containments", [])
            self.containment_outcomes = data.get("containment_outcomes", [])
            self.alerts = data.get("alerts", [])
            self.drift_checks = data.get("drift_checks", [])
            logger.info("Loaded security metrics history successfully.")
        except Exception as e:
            logger.error(f"Failed to load metrics statistics: {e}")

    def save_stats(self) -> None:
        data = {
            "normalization_latencies": self.normalization_latencies,
            "rule_latencies": self.rule_latencies,
            "correlation_latencies": self.correlation_latencies,
            "risk_latencies": self.risk_latencies,
            "confidence_latencies": self.confidence_latencies,
            "detections": self.detections,
            "containments": self.containments,
            "containment_outcomes": self.containment_outcomes,
            "alerts": self.alerts,
            "drift_checks": self.drift_checks
        }

        try:
            os.makedirs(os.path.dirname(self.stats_path), exist_ok=True)
            temp_path = self.stats_path + ".tmp"
            with open(temp_path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=4)
            try:
                os.replace(temp_path, self.stats_path)
            except Exception:
                with open(self.stats_path, "w", encoding="utf-8") as f:
                    json.dump(data, f, indent=4)
                if os.path.exists(temp_path):
                    try:
                        os.remove(temp_path)
                    except Exception:
                        pass
        except Exception as e:
            logger.error(f"Failed to save metrics statistics: {e}")

    def record_latency(self, step: str, seconds: float) -> None:
        if step == "normalization":
            self.normalization_latencies.append(seconds)
        elif step == "rule_matching":
            self.rule_latencies.append(seconds)
        elif step == "correlation":
            self.correlation_latencies.append(seconds)
        elif step == "risk_scoring":
            self.risk_latencies.append(seconds)
        elif step == "confidence_calculation":
            self.confidence_latencies.append(seconds)
        else:
            logger.warning(f"Unknown latency step recorded: {step}")
            return

        self.save_stats()

    def record_detection(self, event_time: float, detect_time: float) -> None:
        self.detections.append({"event_time": event_time, "detect_time": detect_time})
        self.save_stats()

    def record_containment(self, detect_time: float, respond_time: float, success: bool) -> None:
        self.containments.append({"detect_time": detect_time, "respond_time": respond_time})
        self.containment_outcomes.append(success)
        self.save_stats()

    def record_alert(self, tier: str) -> None:
        self.alerts.append(tier)
        self.save_stats()

    def record_drift_check(self, drift_count: int) -> None:
        self.drift_checks.append({"timestamp": time.time(), "drift_count": drift_count})
        self.save_stats()

    def generate_kpi_report(self) -> Dict[str, Any]:
        def get_avg_ms(latencies: List[float]) -> float:
            if not latencies:
                return 0.0
            return (sum(latencies) / len(latencies)) * 1000.0

        avg_latencies = {
            "normalization": round(get_avg_ms(self.normalization_latencies), 3),
            "rule_matching": round(get_avg_ms(self.rule_latencies), 3),
            "correlation": round(get_avg_ms(self.correlation_latencies), 3),
            "risk_scoring": round(get_avg_ms(self.risk_latencies), 3),
            "confidence_calculation": round(get_avg_ms(self.confidence_latencies), 3)
        }

        mttd_sum = 0.0
        for d in self.detections:
            mttd_sum += max(0.0, d["detect_time"] - d["event_time"])
        avg_mttd = round(mttd_sum / len(self.detections), 2) if self.detections else 0.0

        mttr_sum = 0.0
        for c in self.containments:
            mttr_sum += max(0.0, c["respond_time"] - c["detect_time"])
        avg_mttr = round(mttr_sum / len(self.containments), 2) if self.containments else 0.0

        success_rate = 100.0
        if self.containment_outcomes:
            success_count = sum(1 for o in self.containment_outcomes if o)
            success_rate = round((success_count / len(self.containment_outcomes)) * 100.0, 2)

        fp_rate = 0.0
        if self.alerts:
            monitor_alerts = sum(1 for a in self.alerts if a.lower() == "monitor")
            fp_rate = round((monitor_alerts / len(self.alerts)) * 100.0, 2)

        report = {
            "average_latencies_ms": avg_latencies,
            "incident_lifecycle_seconds": {"mttd": avg_mttd, "mttr": avg_mttr},
            "containment_success_rate": success_rate,
            "false_positive_rate": fp_rate,
            "drift_frequency": len(self.drift_checks),
            "total_incidents_recorded": len(self.detections)
        }

        logger.info(f"Generated KPI report. MTTD: {avg_mttd}s | MTTR: {avg_mttr}s | Success Rate: {success_rate}%")
        return report
